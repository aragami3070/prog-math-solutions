  "query": "\n        SELECT l.document_id, p.post_number, l.target_url, l.anchor_text\n        FROM links AS l\n        JOIN posts AS p ON p.id = l.post_id\n        WHERE l.document_id = ANY($1)\n        ORDER BY l.document_id, p.post_number, l.id\n        ",
