{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id,\n            source,\n            native_id,\n            canonical_url,\n            title,\n            LEFT(body_text, 320) AS \"excerpt!\",\n            CHAR_LENGTH(body_text)::BIGINT AS \"text_chars!\",\n            completeness,\n            completeness_reason,\n            first_seen_at,\n            last_seen_at\n        FROM documents\n        ORDER BY first_seen_at DESC, id DESC\n        LIMIT $1 OFFSET $2\n        ",
