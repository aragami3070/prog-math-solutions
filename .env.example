# Local development defaults only. Do not use these credentials in production.
# The backend automatically loads .env from its working directory on startup.
DATABASE_URL=postgres://rks:rks@127.0.0.1:5433/rks
# Local API: only loopback addresses are accepted.
HTTP_BIND=127.0.0.1:8080
WEB_DIST=web/dist
RUST_LOG=rust_knowledge=info,tower_http=info
# Compile SQLx macros using the checked-in .sqlx metadata.
SQLX_OFFLINE=true
# With no crawler User-Agent, collecting is disabled; reading remains available.
# Example after replacing the email with your actual contact:
# CRAWLER_USER_AGENT="RustKnowledgeCollector/0.1 (+mailto:you@your-domain.org)"
CRAWLER_USER_AGENT=
CRAWL_DELAY_SECONDS=5
